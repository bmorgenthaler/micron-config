# macros/preprint_check.cfg
# Blocking pre-print confirmation dialog (action:prompt). Call from the slicer start
# gcode BEFORE PRINT_START, so nothing heats/homes while the dialog waits:
#   PREPRINT_CHECK MSG="Is the build sheet installed and clean?"
# Continue -> resumes straight into PRINT_START (full homing/soak/QGL/mesh chain still
# runs), Cancel -> CANCEL_PRINT.
# [respond] is already defined by mainsail-config/client.cfg — not redeclared here.
#
# Uses the built-in PAUSE_BASE/RESUME_BASE, NOT Mainsail's PAUSE/RESUME wrappers:
# Mainsail's PAUSE parks (Z+2, X161/Y185) whenever xyz is still homed from an earlier
# job, and does a cold 1mm retract (min_extrude_temp: 0). If the dialog then sat past
# idle_timeout (M84), RESUME's move back from the park position failed with "Must home
# axis first". The built-ins never move the toolhead, so RESUME_BASE's
# RESTORE_GCODE_STATE MOVE=1 is a zero-length move, which toolhead.move() drops before
# check_move() — safe homed or not, motors enabled or not.
#
# Use the dialog buttons, not Mainsail's Resume button: Resume works but leaves the
# dialog open (only the buttons send prompt_end), and goes through Mainsail's RESUME
# (cold 1mm unretract). last_extruder_temp is reset below so that path can't M109 to a
# stale temp left over from an earlier mid-print pause.

[gcode_macro PREPRINT_CHECK]
description: Pause and ask user to confirm before printing
gcode:
  {% set msg = params.MSG|default("Confirm before continuing")|string %}
  SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=last_extruder_temp VALUE="{{'restore': False, 'temp': 0}}"
  RESPOND TYPE=command MSG="action:prompt_begin Pre-print check"
  RESPOND TYPE=command MSG="action:prompt_text {msg}"
  RESPOND TYPE=command MSG="action:prompt_footer_button Cancel|_CHECK_CANCEL|error"
  RESPOND TYPE=command MSG="action:prompt_footer_button Continue|_CHECK_OK|primary"
  RESPOND TYPE=command MSG="action:prompt_show"
  PAUSE_BASE

[gcode_macro _CHECK_OK]
gcode:
  RESPOND TYPE=command MSG="action:prompt_end"
  RESUME_BASE

[gcode_macro _CHECK_CANCEL]
gcode:
  RESPOND TYPE=command MSG="action:prompt_end"
  CANCEL_PRINT
