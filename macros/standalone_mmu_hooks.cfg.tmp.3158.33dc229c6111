# Happy-Hare-shaped hook macros for the standalone (no MMU yet) filament system. Mirrors the
# documented pipeline in Happy Hare's mmu_sequence.cfg:
#   Unloading: _MMU_PRE_UNLOAD -> [form_tip] -> _MMU_POST_FORM_TIP -> _MMU_POST_UNLOAD
#   Loading:   _MMU_PRE_LOAD -> [load] -> _MMU_POST_LOAD
# with a matching error hook (_MMU_ERROR). This file's macros use a distinct "_STANDALONE_*"
# prefix rather than Happy Hare's real names — those will be installed later as read-only
# symlinked files by Happy Hare's own installer, and colliding with them would break config
# load at that point. Call sites for each hook live in macros/filament.cfg; see that file's
# comments at each insertion point.
#
# Each hook is a thin wrapper: read its user_*_extension string from
# _STANDALONE_SEQUENCE_VARS (macros/standalone_mmu_vars.cfg) and run it verbatim. An empty
# string is a no-op, so adding a hook call site never changes behavior on its own — only
# populating the corresponding variable does.

[gcode_macro _STANDALONE_PRE_UNLOAD]
description: Hook — fires before unload starts (before the pre-cut retract in _CUT_UNLOAD_SEQUENCE).
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_pre_unload_extension|default("")}

[gcode_macro _STANDALONE_POST_FORM_TIP]
description: Hook — fires right after tip forming/cutting, before the post-cut retract loop.
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_post_form_tip_extension|default("")}

[gcode_macro _STANDALONE_POST_UNLOAD]
description: Hook — fires after unload completes (lower sensor confirmed clear).
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_post_unload_extension|default("")}

[gcode_macro _STANDALONE_PRE_LOAD]
description: Hook — fires before load starts (before the heat-and-feed sequence).
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_pre_load_extension|default("")}

[gcode_macro _STANDALONE_POST_LOAD]
description: Hook — fires after a confirmed-good purge, before toolhead state is restored.
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_post_load_extension|default("")}

[gcode_macro _STANDALONE_ERROR]
description: Hook — fires when a load is abandoned after max retries (_LOAD_FILAMENT_ABORT).
gcode:
  {% set vars = printer['gcode_macro _STANDALONE_SEQUENCE_VARS'] %}
  {vars.user_mmu_error_extension|default("")}
