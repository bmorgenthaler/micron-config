[gcode_macro PRINT_END]
gcode:
    {% set th = printer.toolhead %}
    # Capture chamber state before TURN_OFF_HEATERS clears it
    # (Jinja evaluates at expansion time, so this reads current state)
    {% set chamber_was_heated = printer["heater_generic chamber"].target > 0 %}

    M400                           ; wait for buffer to clear
    SET_GCODE_OFFSET Z=0           ; clear dynamic Z offset from contact probe
    SET_SKEW CLEAR=1               ; Clear skew profile
    G90                            ; absolute positioning
    G92 E0                         ; zero the extruder
    G1 E-10.0 F3600                ; retract filament

    # Z lift first — clear print before any lateral move
    {% set str_z = [th.position.z + 5.0, th.axis_maximum.z]|min %}
    G0 Z{str_z} F3000

    # Stringing break — bidirectional X/Y with axis clamps
    {% set str_x = th.position.x + (20.0 if th.axis_maximum.x - th.position.x > 20 else -20.0) %}
    {% set str_x = [[str_x, th.axis_minimum.x]|max, th.axis_maximum.x]|min %}
    {% set str_y = th.position.y + (20.0 if th.axis_maximum.y - th.position.y > 20 else -20.0) %}
    {% set str_y = [[str_y, th.axis_minimum.y]|max, th.axis_maximum.y]|min %}
    G0 X{str_x} Y{str_y} F20000

    # PETG-only brush wipe, gated on bed clearance. Must stay before TURN_OFF_HEATERS (needs
    # a hot nozzle) and after the retract above. See _PRINT_END_CLEAN below.
    _PRINT_END_CLEAN LIFT={str_z}

    TURN_OFF_HEATERS
    M107                           ; turn off fan

    RESPOND MSG="Parking"
    # Fixed park target X10/Y185 — outside the mesh area (13-160 both axes), clear of the
    # print regardless of Z. Z targets 60 but never descends below the current post-print
    # lift height, so the diagonal travel move can't drag the nozzle down through a tall
    # finished print on the way to the corner.
    {% set park_x = [[10, th.axis_minimum.x]|max, th.axis_maximum.x]|min %}
    {% set park_y = [[185, th.axis_minimum.y]|max, th.axis_maximum.y]|min %}
    {% set park_z = [[60, th.position.z]|max, th.axis_maximum.z]|min %}
    G0 X{park_x} Y{park_y} Z{park_z} F3600
    M400                           ; park move fully complete before proceeding
    RESPOND MSG="Parked at X{park_x} Y{park_y} Z{park_z}"

    BED_MESH_CLEAR

    # Post-print air circulation — only when chamber was actively heated. Filter fan +
    # forced chamber-fan circulation (TARGET=75 is a proxy to keep BED_FAN running hard,
    # not a real heat target) are left running here; [idle_timeout] (printer.cfg) is what
    # actually turns them off and sends "safe to open", once the printer has genuinely
    # gone idle (1800s) rather than on a fixed short timer that ran out before the fumes
    # actually cleared. chamber_needs_clear is always written (True/False) so a later
    # unheated print's idle_timeout firing can't act on a stale flag from this one.
    RESPOND MSG="Cycling chamber air"
    {% if chamber_was_heated %}
      SET_HEATER_TEMPERATURE HEATER=chamber TARGET=75
    {% endif %}
    SAVE_VARIABLE VARIABLE=chamber_needs_clear VALUE={chamber_was_heated}

    _STATUS_PART_READY
    RESPOND MSG=""
    UPDATE_DELAYED_GCODE ID=_notify_print_complete DURATION=120


# End-of-print nozzle wipe for PETG, run only if the area around the brush is clear of the
# finished print. Clearance comes from [exclude_object] polygons (printer.exclude_object.objects
# stays populated until the next file loads, so it's still valid during PRINT_END). Verified
# against 11 recent gcode files: all extrusion stays inside the polygons across all layers.
# Object height isn't checked: XY travel stays at print height + 5, and the nozzle only
# descends once over the brush, so only the XY footprint around the brush can collide.
# Fails closed: unmeasured toolhead_front, no labeled objects, or an object with no polygon
# all skip the wipe. Excluded/cancelled objects still count, since part may be on the bed.
[gcode_macro _PRINT_END_CLEAN]
description: PETG-only end-of-print CLEAN_NOZZLE, gated on object clearance around the brush.
variable_material: ""             # set by PRINT_START
variable_toolhead_front: 20       # measured 2026-11-02: nozzle to front-most toolhead point, mm. 0 = wipe disabled
variable_toolhead_half_width: 26  # PC fan duct spans nozzle_X +/- 26mm
variable_margin: 5                # extra clearance on every side (also covers brim/skirt, mm)
gcode:
  {% set b = printer["gcode_macro CLEAN_NOZZLE"] %}
  {% set objs = printer.exclude_object.objects %}
  {% set y_min = b.start_y - b.zigzag_amplitude - toolhead_front - margin %}
  {% set x_min = b.start_x - toolhead_half_width - margin %}
  {% set x_max = b.start_x + b.wipe_width + toolhead_half_width + margin %}
  {% set clean_temp = [printer.extruder.target * 0.85, 150]|max|int %}
  {% set s = namespace(clear=objs|length > 0, why="no labeled objects") %}
  {% for o in objs %}
    {% if 'polygon' not in o %}
      {% set s.clear = False %}
      {% set s.why = o.name ~ " has no polygon" %}
    {% else %}
      {% set xs = o.polygon|map(attribute=0)|list %}
      {% set ys = o.polygon|map(attribute=1)|list %}
      {% if ys|max > y_min and xs|max > x_min and xs|min < x_max %}
        {% set s.clear = False %}
        {% set s.why = o.name ~ " reaches Y" ~ ys|max %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if toolhead_front <= 0 %}
    {% set s.clear = False %}
    {% set s.why = "toolhead_front not measured" %}
  {% endif %}

  {% if material == "PETG" %}
    {% if s.clear %}
      # Y180 is outside the mesh area and the mesh is fully applied at Z0, so the wipe would
      # otherwise run at a clamped mesh-edge value.
      BED_MESH_CLEAR
      G0 X{b.start_x} Y{b.start_y} F6000
      M104 S{clean_temp}
      M106 S255
      TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={clean_temp + 3}
      M106 S0
      CLEAN_NOZZLE
      # CLEAN_NOZZLE only rises to Z10. Restore print-clearing height before the diagonal park
      # move, or it could sweep the toolhead through a tall object.
      G0 Z{params.LIFT} F3000
    {% else %}
      RESPOND MSG="Skipping end-of-print clean: {s.why}"
    {% endif %}
  {% endif %}
