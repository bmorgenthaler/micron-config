[gcode_macro _CHAMBER_AIR_CLEAR]
description: Turns off the filter fan and the forced chamber-air circulation, clears the
  pending flag, and sends the "safe to open" notification. Called from [idle_timeout]
  (printer.cfg) once the printer has gone genuinely idle after a heated print — timing is
  driven by idle_timeout's own 1800s clock, not a fixed post-print timer. See
  chamber_needs_clear, set by PRINT_END.
gcode:
    SET_FAN_SPEED FAN=filter SPEED=0
    SET_HEATER_TEMPERATURE HEATER=chamber TARGET=0
    SAVE_VARIABLE VARIABLE=chamber_needs_clear VALUE=False
    {action_call_remote_method("notify",
                               name="gcode_pushover",
                               message="Air circulation complete — safe to open.")}

[gcode_macro TOGGLE_FILTER]
gcode:
    {% if printer['fan_generic filter'].speed > 0 %}
        SET_FAN_SPEED FAN=filter SPEED=0
    {% else %}
        SET_FAN_SPEED FAN=filter SPEED=1
    {% endif %}
