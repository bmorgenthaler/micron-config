[tmc2209 extruder]
uart_pin: thb:E_UART
run_current: 0.650
sense_resistor: .100

#################################
# Filament Sensors
#################################
# HH-equivalent toolhead sensor geometry (for future [mmu_sensors] migration). TODO — NEEDS
# LIVE MEASUREMENT when the MMU actually arrives; not yet verified, do not treat as calibrated:
#   toolhead_extruder_to_nozzle : ?? mm  (WWG2 extruder gear entry -> Revo HF nozzle tip)
#   toolhead_sensor_to_nozzle   : ?? mm  (filament_lower / thb:PROBE -> nozzle tip)
#   toolhead_entry_to_extruder  : ?? mm  (filament_upper / thb:FS -> WWG2 extruder gears)
#   toolhead_residual_filament  : 0      (HH default; no reason yet to deviate)
#   extruder_force_homing       : 0      (HH default; filament_lower already serves as the
#                                         toolhead-sensor equivalent)
[filament_switch_sensor filament_upper]
switch_pin: thb:FS
pause_on_runout: False              # CHANGED from True: runout_gcode handles PAUSE explicitly.
                                    # Original True caused double-pause (built-in + PAUSE in runout_gcode).
insert_gcode:
  _INSERT_HANDLER
runout_gcode:
  _RUNOUT_HANDLER
 
[filament_switch_sensor filament_lower]
switch_pin: thb:PROBE
pause_on_runout: False              # Unchanged — safety net handler in runout_gcode instead.
runout_gcode:                       # ADDED: safety net if upper sensor is bypassed (e.g. mid-path break).
  _LOWER_RUNOUT_HANDLER
