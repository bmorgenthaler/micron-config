# Happy-Hare-shaped PAUSE/RESUME/CANCEL_PRINT wrapper layer, mirroring the pattern in Happy
# Hare's config/optional/client_macros.cfg: an additional rename_existing layer around the
# already-final PAUSE/RESUME/CANCEL_PRINT, adding user_*_extension escape hatches read from
# _STANDALONE_CLIENT_VARS (macros/standalone_mmu_vars.cfg).
#
# IMPORTANT — load order: this file must be included AFTER [include mainsail.cfg] in
# printer.cfg (mainsail.cfg defines its own PAUSE/RESUME/CANCEL_PRINT via rename_existing, and
# this wrapper needs to capture THOSE, not the stock Klipper ones). It lives in late_includes/
# rather than macros/ specifically so the [include macros/*.cfg] wildcard (which loads before
# mainsail.cfg) can't also pick it up — confirmed live 2026-08-20 that Klipper dedupes an
# [include] by resolved file path, so a file matched by both a wildcard AND a later explicit
# include only actually loads ONCE, at the wildcard's (earlier) position. A same-named file
# living inside macros/ silently got captured at the wrong point this way. See
# late_includes/line_purge_safety.cfg for the other file with the same requirement.
#
# rename_existing always captures whatever is currently named PAUSE/RESUME/CANCEL_PRINT at load
# time, so this is safe to layer on top of the existing mainsail -> overrides.cfg -> Klipper
# builtin chain, and safe for Happy Hare's real client_macros.cfg to layer on top of again
# later without conflict.

[gcode_macro PAUSE]
rename_existing: _STANDALONE_PAUSE_BASE
gcode:
  {% set cvars = printer['gcode_macro _STANDALONE_CLIENT_VARS'] %}
  _STANDALONE_PAUSE_BASE {rawparams}
  {cvars.user_pause_extension|default("")}

[gcode_macro RESUME]
rename_existing: _STANDALONE_RESUME_BASE
gcode:
  {% set cvars = printer['gcode_macro _STANDALONE_CLIENT_VARS'] %}
  {cvars.user_resume_extension|default("")}
  _STANDALONE_RESUME_BASE {rawparams}

[gcode_macro CANCEL_PRINT]
rename_existing: _STANDALONE_CANCEL_PRINT_BASE
gcode:
  {% set cvars = printer['gcode_macro _STANDALONE_CLIENT_VARS'] %}
  {cvars.user_cancel_extension|default("")}
  _STANDALONE_CANCEL_PRINT_BASE {rawparams}
