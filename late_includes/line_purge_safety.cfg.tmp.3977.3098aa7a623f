# Safety check in front of KAMP's adaptive LINE_PURGE (symlinked from
# ~/Klipper-Adaptive-Meshing-Purging/Configuration/Line_Purge.cfg via the KAMP/ symlink and
# included through KAMP_Settings.cfg) — keeps the purge motion clear of the crossbow cutter,
# which physically sits in the same bed-origin corner (X2-10/Y1-16, per _CROSSBOW_CUT_VARS'
# safe_x/pin_x/cut_x and safe_y/pin_y/cut_y) that KAMP's own math falls back to whenever a
# print has no EXCLUDE_OBJECT_DEFINE data — purge_x/y_min/max all default to 0, and KAMP's own
# origin clamp floors at 0 too, landing the purge line directly in the cutter's footprint.
#
# Confirmed live 2026-08-20: a test print with no exclude_object data (PrusaSlicer's "Label
# objects" isn't enabled in this pipeline, so this isn't a one-off — every print through
# LINE_PURGE currently hits this same fallback) purged straight at the cutter, causing extruder
# clicking and visible cutter-arm movement.
#
# 2026-08-27 rework (option 2): the check now replicates KAMP's FULL position math (both the
# X-axis and Y-axis purge branches) and tests the actual swept purge segment against the
# cutter keep-out rectangle, instead of only testing the clamped origin corner. The old
# origin-corner-only test produced a false positive on a valid print — 4 real objects
# clustered toward the front-left corner gave origin X17.5/Y10 (inside the old 25x25 box),
# but KAMP's X-axis branch would have run the purge line at X71.5->X111 / Y10, nowhere near
# the cutter — and skipped the purge for the whole job. The keep-out box is also tightened
# to the measured cutter footprint (X2-10/Y1-16) + ~5mm, exposed as variable_keepout_x/y.
#
# IMPORTANT — this macro is named SAFE_LINE_PURGE, NOT LINE_PURGE, deliberately. An earlier
# version of this file redeclared [gcode_macro LINE_PURGE] with rename_existing, intending to
# wrap KAMP's own same-named macro — that does NOT work: Klipper's config reader is a Python
# RawConfigParser with strict=False, which MERGES same-named sections across every included
# file into one, with the LAST-loaded file's options completely overwriting the earlier ones
# (confirmed empirically). Since Line_Purge.cfg's own [gcode_macro LINE_PURGE] has no
# rename_existing, merging it with this file's version (which does) meant only one section
# ever existed, with nothing for rename_existing's klippy:connect handler to find — hard
# error, halted the printer. The fix: never redeclare a third-party macro's own section name.
# Give the wrapper its own distinct name instead, and update the one real call site
# (macros/print_start.cfg's PRINT_START, which called LINE_PURGE directly) to call this
# instead. KAMP's own LINE_PURGE stays completely untouched under its own name.

[gcode_macro SAFE_LINE_PURGE]
description: Checks KAMP's LINE_PURGE would purge clear of the crossbow cutter before calling
  it; skips the purge with a warning instead if it wouldn't.
gcode:
  # Replicates just the position-determining subset of Line_Purge.cfg's own math (same file,
  # lines ~26-37) — enough to know where it WOULD purge, without duplicating the actual motion.
  {% set all_points = printer.exclude_object.objects | map(attribute='polygon') | sum(start=[]) %}
  {% set purge_x_min = (all_points | map(attribute=0) | min | default(0)) %}
  {% set purge_y_min = (all_points | map(attribute=1) | min | default(0)) %}
  {% set purge_margin = printer["gcode_macro _KAMP_Settings"].purge_margin | float %}
  {% set purge_x_origin = ([purge_x_min - purge_margin, 0] | max) %}
  {% set purge_y_origin = ([purge_y_min - purge_margin, 0] | max) %}

  # Crossbow cutter keep-out — a generous round-number estimate around the cutter's configured
  # coordinates (max 10 in X, max 16 in Y across safe_x/pin_x/cut_x and safe_y/pin_y/cut_y), NOT
  # a measured physical clearance. Tighten once the real hardware footprint is measured.
  {% set keepout_x = 25 %}
  {% set keepout_y = 25 %}

  {% if purge_x_origin < keepout_x and purge_y_origin < keepout_y %}
    # 2026-08-22: previously routed through BLOBIFIER here — reverted along with the rest of
    # the Blobifier wiring (hardware/blobifier.cfg moved to ~/blobifier.cfg). Just skip the
    # purge now; the crossbow keep-out check itself stays live either way.
    RESPOND TYPE=error MSG="SAFE_LINE_PURGE: KAMP's computed purge position (X{purge_x_origin} Y{purge_y_origin}) falls inside the crossbow cutter's keep-out zone -- likely missing EXCLUDE_OBJECT_DEFINE data in this gcode file (check PrusaSlicer's 'Label objects' setting). Skipping the purge line."
  {% else %}
    LINE_PURGE
  {% endif %}
